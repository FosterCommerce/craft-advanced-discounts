{% extends '_layouts/cp' %}

{% set fullPageForm = true %}
{# Conditions and actions apply to every site. The site menu only picks which site's text to edit. #}
{% set requestedSite = craft.app.isMultiSite ? craft.cp.requestedSite : null %}
{% set crumbs = [
    { label: 'nav.title'|t('advanced-discounts'), url: url('advanced-discounts', requestedSite ? { site: requestedSite.handle } : {}) },
] %}
{% if requestedSite %}
    {% set crumbs = crumbs|unshift({
        id: 'site-crumb',
        icon: 'world',
        label: requestedSite.name|t('site'),
        menu: {
            items: siteMenuItems(null, requestedSite),
            label: 'Select site'|t('app'),
        },
    }) %}
{% endif %}
{% set title = discount.id ? (requestedSite ? discount.getNameForSite(requestedSite) : discount.name) : 'edit.createTitle'|t('advanced-discounts') %}
{% import '_includes/forms.twig' as forms %}

{% do view.registerAssetBundle('fostercommerce\\advanceddiscounts\\web\\assets\\discounts\\DiscountsAsset') %}

{% block actionButton %}
    <button type="submit" class="btn submit">{{ 'edit.save'|t('advanced-discounts') }}</button>
{% endblock %}

{% block content %}
    {{ actionInput('advanced-discounts/manage/save') }}
    {{ redirectInput('advanced-discounts/{id}' ~ (requestedSite ? '?site=' ~ requestedSite.handle : '')) }}

    {% if discount.id %}
        <input type="hidden" name="id" value="{{ discount.id }}">
    {% endif %}

    {% if requestedSite %}
        <input type="hidden" id="site-text-site" value="{{ requestedSite.uid }}">
    {% endif %}

    {# Keep the Name field visible while it has an error, so the error shows on any site #}
    {{ forms.textField({
        label: 'edit.name'|t('advanced-discounts'),
        id: 'name',
        name: 'name',
        value: discount.name,
        type: 'text',
        inputAttributes: {
            data: {lpignore: 'true'},
        },
        required: true,
        errors: discount.getErrors('name')|merge(discount.getErrors('siteNames')),
        siteId: craft.app.sites.primarySite.id,
        fieldAttributes: discount.hasErrors('name') or discount.hasErrors('siteNames') ? {} : { data: { 'site-text': craft.app.sites.primarySite.uid } },
    }) }}
    {% if craft.app.isMultiSite %}
        {% for site in craft.app.sites.allSites|filter(site => not site.primary) %}
            {{ forms.textField({
                label: 'edit.name'|t('advanced-discounts'),
                name: 'siteNames[' ~ site.uid ~ ']',
                value: discount.siteNames[site.uid] ?? '',
                placeholder: discount.name,
                maxlength: 255,
                inputAttributes: {
                    data: {lpignore: 'true'},
                },
                siteId: site.id,
                fieldAttributes: { class: ['hidden'], data: { 'site-text': site.uid } },
            }) }}
        {% endfor %}
    {% endif %}

    {{ forms.lightswitchField({
        label: 'index.column.requireCouponCode'|t('advanced-discounts'),
        id: 'requireCouponCode',
        name: 'requireCouponCode',
        on: discount.requireCouponCode,
        toggle: '#coupons-container',
        instructions: 'edit.requireCouponCode.instructions'|t('advanced-discounts'),
    }) }}

    <div id="coupons-container"{% if not discount.requireCouponCode %} class="hidden"{% endif %}>
        {% set couponRows = [] %}
        {% for coupon in discount.coupons %}
            {% set couponRows = couponRows|merge([{
                id: coupon.id,
                code: coupon.code,
                uses: coupon.uses,
                maxUses: coupon.maxUses,
            }]) %}
        {% endfor %}

        {% set couponsField %}
            {{ forms.editableTable({
                id: 'coupons-table',
                name: 'coupons',
                cols: {
                    id: {
                        type: 'singleline',
                        heading: 'ID',
                        class: 'hidden',
                    },
                    code: {
                        type: 'singleline',
                        heading: 'edit.coupons.code'|t('advanced-discounts'),
                    },
                    uses: {
                        type: 'singleline',
                        heading: 'edit.coupons.uses'|t('advanced-discounts'),
                    },
                    maxUses: {
                        type: 'singleline',
                        heading: 'edit.coupons.maxUses'|t('advanced-discounts'),
                        info: 'edit.coupons.maxUsesInstructions'|t('advanced-discounts'),
                    },
                },
                rows: couponRows,
                addRowLabel: 'edit.coupons.add'|t('advanced-discounts'),
                allowAdd: true,
                allowDelete: true,
                defaultValues: {
                    uses: 0,
                },
            }) }}
        {% endset %}

        {{ forms.field({
            label: 'index.column.coupons'|t('advanced-discounts'),
            errors: discount.getErrors('coupons'),
            headingSuffix: tag('button', {
                id: 'generate-coupons',
                type: 'button',
                class: ['btn', 'small'],
                text: 'edit.coupons.generate'|t('advanced-discounts'),
            }),
        }, couponsField) }}
    </div>


    {% set globalCartCondition %}
        {{ discount.globalCartCondition.getBuilderHtml()|raw }}
    {% endset %}

    {{ forms.field({
        label: 'edit.globalCartConditions'|t('advanced-discounts'),
        instructions: 'edit.globalCartConditions.instructions'|t('advanced-discounts'),
    }, globalCartCondition) }}

    {{ forms.selectField({
        label: 'index.column.type'|t('advanced-discounts'),
        id: 'type',
        name: 'type',
        options: typeOptions,
        value: discount.type,
    }) }}

    <div id="type-settings">
        {{ typeSettingsHtml|raw }}
    </div>


    <div class="pane tip">
        <h2>{{ 'edit.notes.title'|t('advanced-discounts') }}</h2>
        <ul class="bullets">
            <li>{{ 'edit.notes.ordering'|t('advanced-discounts') }}</li>
            <li>{{ 'edit.notes.tiers'|t('advanced-discounts') }}</li>
            <li>{{ 'edit.notes.globalConditions'|t('advanced-discounts') }}</li>
            <li>{{ 'edit.notes.messageFallback'|t('advanced-discounts') }}</li>
            <li>{{ 'edit.notes.messageOrdering'|t('advanced-discounts') }}</li>
            <li><code>{amountRemaining}</code> {{ 'edit.notes.amountRemaining'|t('advanced-discounts') }}</li>
            <li>{{ 'edit.notes.nonPromotable'|t('advanced-discounts') }}</li>
        </ul>
    </div>


    <div class="pane advanced-discount-placeholders">
        <h2>{{ 'edit.messagePlaceholders.title'|t('advanced-discounts') }}</h2>
        <div id="message-placeholders-table">
            {% include 'advanced-discounts/_message-placeholders-table' with { placeholders: discount.getType().messagePlaceholders() } only %}
        </div>
    </div>
{% endblock %}

{% block details %}
    <div class="meta">
        {{ forms.lightswitchField({
            label: 'Enable this discount'|t('commerce'),
            id: 'enabled',
            name: 'enabled',
            on: discount.enabled,
        }) }}

        {{ forms.lightswitchField({
            label: 'edit.stopProcessing'|t('advanced-discounts'),
            instructions: 'edit.stopProcessing.instructions'|t('advanced-discounts'),
            id: 'stopProcessing',
            name: 'stopProcessing',
            on: discount.stopProcessing,
        }) }}

        {{ forms.selectField({
            label: 'settings.taxBasis'|t('advanced-discounts'),
            instructions: 'edit.taxBasis.instructions'|t('advanced-discounts'),
            id: 'taxBasis',
            name: 'taxBasis',
            options: [{ label: 'settings.taxBasis.usePluginDefault'|t('advanced-discounts'), value: '' }]|merge(taxBasisOptions),
            value: discount.taxBasis,
        }) }}
    </div>
{% endblock %}
