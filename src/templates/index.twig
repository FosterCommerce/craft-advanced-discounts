{% extends '_layouts/cp' %}

{% do view.registerAssetBundle('fostercommerce\\advanceddiscounts\\web\\assets\\discounts\\DiscountsAsset') -%}

{% set title = 'nav.title'|t('advanced-discounts') %}
{% set selectedSubnavItem = 'discounts' %}

{% set additionalButtons %}
	<a class="btn submit add icon" href="{{ url('advanced-discounts/new') }}">{{ 'index.newDiscount'|t('advanced-discounts') }}</a>
{% endset %}


{% set content %}
	<div id="advanced-discounts-list"></div>
	{% include 'advanced-discounts/_includes/plugin-footer' %}
{% endset %}

{% js %}
	let columns = [
		{ name: '__slot:title', title: Craft.t('app', 'Name') },
		{
			name: 'type',
			title: Craft.t('advanced-discounts', 'index.column.type'),
		},
		{
			name: 'requireCouponCode',
			title: Craft.t('advanced-discounts', 'index.column.requireCouponCode'),
			callback: (value) => value ? '<span data-icon="check"></span>' : '',
		},
		{
			name: 'coupons',
			title: Craft.t('advanced-discounts', 'index.column.coupons'),
			callback: (value) => value ? value : '',
		},
		{
			name: 'timesUsed',
			title: Craft.t('advanced-discounts', 'index.column.timesUsed'),
			callback: (value) => value ? value : '',
		},
		{
			name: 'stopProcessing',
			title: Craft.t('advanced-discounts', 'index.column.stopsProcessing'),
			callback: (value) => value ? '<span data-icon="check"></span>' : '',
		},
		{
			name: 'dateCreated',
			title: Craft.t('advanced-discounts', 'index.column.dateCreated'),
		},
	];

	new Craft.VueAdminTable({
		columns,
		padded: true,
		container: '#advanced-discounts-list',
		emptyMessage: Craft.t('advanced-discounts', 'index.empty'),
		search: true,
		checkboxes: true,
		tableData: {{ tableData|json_encode|raw }},
		deleteAction: 'advanced-discounts/manage/delete',
		reorderAction: 'advanced-discounts/manage/reorder',
		reorderSuccessMessage: Craft.t('advanced-discounts', 'index.flash.reordered'),
		reorderFailMessage: Craft.t('advanced-discounts', 'index.flash.reorderFailed'),
	});
{% endjs %}
