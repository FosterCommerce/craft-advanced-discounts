{% import '_includes/forms.twig' as forms %}

{% if discount.getErrors('panels') %}
    <ul class="errors">
        {% for error in discount.getErrors('panels') %}
            <li>{{ error }}</li>
        {% endfor %}
    </ul>
{% endif %}

<div id="panels" class="advanced-discount-panels" data-discount-type="{{ discount.type }}" role="list">
    {% for panel in discount.panels %}
        {% include 'advanced-discounts/_panel' with { panel: panel, actionLabel: actionLabel, actionInstructions: actionInstructions, bundle: bundle } only %}
    {% endfor %}
</div>

<button type="button" class="btn add icon" id="add-panel">{{ 'group.add'|t('advanced-discounts') }}</button>
