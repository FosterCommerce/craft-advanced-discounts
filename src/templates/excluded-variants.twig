{% extends '_layouts/cp' %}

{% do view.registerAssetBundle('fostercommerce\\advanceddiscounts\\web\\assets\\discounts\\DiscountsAsset') -%}

{% set title = 'nav.excludedVariants'|t('advanced-discounts') %}
{% set selectedSubnavItem = 'excluded-variants' %}


{% set content %}
	<p>{{ 'excludedVariants.intro'|t('advanced-discounts') }}</p>
	<div id="excluded-variants-list"></div>
	{% include 'advanced-discounts/_includes/plugin-footer' %}
{% endset %}

{% js %}
	new Craft.VueAdminTable({
		columns: [
			{ name: '__slot:title', title: Craft.t('advanced-discounts', 'excludedVariants.column.variant') },
			{ name: 'sku', title: Craft.t('advanced-discounts', 'excludedVariants.column.sku') },
			{ name: 'product', title: Craft.t('advanced-discounts', 'excludedVariants.column.product') },
		],
		container: '#excluded-variants-list',
		emptyMessage: Craft.t('advanced-discounts', 'excludedVariants.empty'),
		search: true,
		padded: true,
		perPage: 100,
		tableDataEndpoint: 'advanced-discounts/manage/excluded-variants-data',
	});
{% endjs %}
